# Gateway auth
# REQUIRED for any public deployment. Requests are rejected when this is empty
# unless ALLOW_INSECURE_NO_SECRET=1 is explicitly set for local testing.
API_SECRET=change-me
ALLOW_INSECURE_NO_SECRET=0

# Optional browser CORS allowlist. Leave empty to disable cross-origin access.
# Multiple origins may be comma-separated. Avoid * on public deployments.
CORS_ALLOW_ORIGIN=

PORT=8000
UPSTREAM_READ_TIMEOUT=180

# OpenAI-compatible upstream
LLM_BASE_URL=https://example.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=replace-me

# Public generic system prompt. Keep personal prompts in a private overlay or DB.
SYSTEM_PROMPT=You are a helpful AI assistant.
INCLUDE_TIME_CONTEXT=1

# How gateway context interacts with a client's existing system message:
# prepend (default) = gateway context first + preserve client system
# append            = preserve client system first + gateway context after it
# replace           = overwrite client system completely
SYSTEM_INJECTION_MODE=prepend

# Disabled by default. Enables the harmless example tool schema.
INJECT_PUBLIC_TOOLS=0
