# ── Security ────────────────────────────────────────────────
# REQUIRED for public deployment. No-secret mode is only for deliberate local testing.
API_SECRET=change-me
ALLOW_INSECURE_NO_SECRET=0
CORS_ALLOW_ORIGIN=
PORT=8000
UPSTREAM_READ_TIMEOUT=180

# ── Generic identity / prompt ───────────────────────────────
# These replace private hard-coded names. Change them for your own deployment.
AI_NAME=Assistant
USER_NAME=User
OWNER_ALIAS=Owner
APP_TIMEZONE=Asia/Shanghai
DEFAULT_CITY=
SYSTEM_PROMPT=You are a helpful AI assistant.
INCLUDE_TIME_CONTEXT=1
SYSTEM_INJECTION_MODE=prepend

# ── Default OpenAI-compatible upstream ─────────────────────
LLM_BASE_URL=https://example.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=replace-me

# Optional independent channels. If blank, non-chat channels fall back to chat.
CHAT_BASE_URL=
CHAT_API_KEY=
CHAT_MODEL=
BG_CHAT_BASE_URL=
BG_CHAT_API_KEY=
BG_CHAT_MODEL=
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
PROACTIVE_BASE_URL=
PROACTIVE_API_KEY=
PROACTIVE_MODEL=
QQ_LLM_BASE_URL=
QQ_LLM_API_KEY=
QQ_LLM_MODEL=
WX_LLM_BASE_URL=
WX_LLM_API_KEY=
WX_LLM_MODEL=

# ── Persistence / memory ────────────────────────────────────
# Optional. Without Supabase the gateway still proxies chat, but persistent memory,
# summaries, reminders and threads are disabled.
SUPABASE_URL=
SUPABASE_KEY=
MEM0_API_KEY=
MEM0_USER_ID=default-user

# ── Telegram ────────────────────────────────────────────────
TG_BOT_TOKEN=
TG_OWNER_ID=
TG_GROUP_IDS=

# ── QQ / OneBot v11 forward WebSocket ─────────────────────
QQ_WS_TOKEN=
QQ_BOT_ID=
QQ_BOT_NAME=Assistant
QQ_OWNER_ID=
QQ_GROUP_IDS=

# ── Optional public MCP examples ───────────────────────────
# Point these at YOUR servers. No private MCP endpoint is bundled in this repository.
WEATHER_MCP_URL=
SEARCH_MCP_URL=

# Internal generic tools (memory/activity/reminder/MCP examples).
INJECT_PUBLIC_TOOLS=0
MAX_INTERNAL_TOOL_ROUNDS=6
