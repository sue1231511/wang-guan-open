# Gateway auth
API_SECRET=change-me
PORT=8000

# OpenAI-compatible upstream
LLM_BASE_URL=https://example.com/v1
LLM_API_KEY=replace-with-your-own-key
LLM_MODEL=replace-with-your-model

# Generic identity labels. Do not commit personal values here.
ASSISTANT_NAME=Assistant
USER_NAME=User

# Optional custom persona text. Prefer injecting this at deploy time.
PERSONA_TEXT=

# Timeout between upstream streamed bytes
UPSTREAM_READ_TIMEOUT=180
